---
/**
 * <Derivation module="dcm" /> -- renders the steps exported from
 * python/pe_core/derive/<module>.py (derivations.generated.json) with strict
 * KaTeX. Each "reproduces" line is backed by pytest
 * (python/pe_core/tests/test_derivations.py).
 */
import katex from 'katex';
import derivations from 'pe-core/equations/derivations.generated.json';
import { catalog } from 'pe-core';
import { REPO_BLOB } from '../config';
import { katexOptions } from '../math/katex-options';
import { renderInlineMath } from '../math/inline';
import { fieldIn } from '../i18n/ui';
import { pageLocale } from '../lib/locale';

interface Props {
  module: string;
}
const { module } = Astro.props;
const d = derivations.derivations.find((x) => x.module === module);
if (!d) throw new Error(`<Derivation module="${module}">: no such module in derivations.generated.json`);
const locale = pageLocale(Astro);
const t = {
  en: { reproduces: 'reproduces', source: 'Derivation script', checked: 'equality checked symbolically by pytest' },
  ko: { reproduces: '재현하는 수식', source: '유도 스크립트', checked: 'pytest가 sympy로 일치를 검증함' },
  zh: { reproduces: '复现的公式', source: '推导脚本', checked: 'pytest 用 sympy 验证两者相等' },
}[locale];
---

<div class="pe-deriv not-content" id={`deriv-${d.module}`}>
  <p class="pe-deriv__intro" set:html={renderInlineMath(fieldIn(d, 'intro', locale))} />
  <ol class="pe-deriv__steps">
    {
      d.steps.map((st) => (
        <li class={st.result_for ? 'pe-deriv__step is-result' : 'pe-deriv__step'}>
          <p set:html={renderInlineMath(fieldIn(st, 'text', locale))} />
          {st.latex && <div class="pe-deriv__math" set:html={katex.renderToString(st.latex, katexOptions(true))} />}
          {st.result_for && (
            <p class="pe-deriv__match">
              ✓ {t.reproduces}{' '}
              <a
                href={`${REPO_BLOB}/packages/pe-core/equations/equations.yaml#L${catalog.equations[st.result_for]?.yaml_line ?? 1}`}
              >
                <code>{st.result_for}</code>
              </a>{' '}
              ({t.checked})
            </p>
          )}
        </li>
      ))
    }
  </ol>
  <p class="pe-deriv__source">
    {t.source}: <a href={`${REPO_BLOB}/${d.source}`}><code>{d.source}</code></a>
  </p>
</div>
