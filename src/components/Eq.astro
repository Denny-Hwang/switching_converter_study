---
/**
 * <Eq id="flyback.dcm.M" /> -- the only way to show an equation in the docs.
 *
 * Renders the LaTeX generated from packages/pe-core/equations/equations.yaml
 * with strict KaTeX at build time, what each of its symbols means (the
 * catalogue's `meaning`), a "verified by N tests" badge, and an expander with
 * assumptions, convention, notes, sources and derivation.
 * An unknown id, an unknown or VERIFY citation key, or any KaTeX error fails
 * the build.
 */
import katex from 'katex';
import { catalog, getEquation } from 'pe-core';
import { REPO_BLOB } from '../config';
import { ui } from '../i18n/ui';
import { katexOptions } from '../math/katex-options';
import { renderInlineMath } from '../math/inline';
import { citable } from '../lib/references';
import { BIBLIOGRAPHY_SLUG, DERIVATIONS_SLUG, pageHref } from '../lib/paths';
import { pageLocale } from '../lib/locale';
import { symHtml } from '../lib/sym';

interface Props {
  id: string;
}

const { id } = Astro.props;
const eq = getEquation(id);
const locale = pageLocale(Astro);
const t = ui[locale];

const mathHtml = katex.renderToString(eq.latex, katexOptions(true));
const title = locale === 'ko' ? eq.title_ko : eq.title;
const convention = locale === 'ko' && eq.convention_ko ? eq.convention_ko : eq.convention;
const notes = locale === 'ko' && eq.notes_ko ? eq.notes_ko : eq.notes;
const anchor = `eq-${id.replace(/\./g, '-')}`;
const yamlHref = `${REPO_BLOB}/packages/pe-core/equations/equations.yaml#L${eq.yaml_line}`;
const testsHref = `${REPO_BLOB}/packages/pe-core/test/parity.test.ts`;
const cites = eq.cites.map((c) => ({ ...c, entry: citable(c.key) }));
const derivModule = eq.derived_by?.replace(/^.*\//, '').replace(/\.py$/, '');
// what each symbol of the equation is: the left side, then the inputs and constants in their order
const where = [...new Set([eq.lhs, ...eq.variables, ...eq.constants])].map((name) => {
  const sym = catalog.symbols[name];
  if (!sym) throw new Error(`<Eq id="${id}">: ${name} is not in symbol_table`);
  return {
    name,
    tex: katex.renderToString(sym.latex, katexOptions(false)),
    meaning: symHtml(locale === 'ko' ? sym.meaning_ko : sym.meaning),
  };
});
---

<figure class="pe-eq not-content" id={anchor} data-eq-id={id}>
  <div class="pe-eq__math" set:html={mathHtml} />
  <dl class="pe-eq__where" aria-label={t['eq.where']}>
    {
      where.map((w) => (
        <div>
          <dt set:html={w.tex} />
          <dd set:html={w.meaning} />
        </div>
      ))
    }
  </dl>
  <figcaption class="pe-eq__caption">
    <span class="pe-eq__title">{title}</span>
    <a class="pe-eq__badge" href={testsHref} title={eq.expr}>✓ {t['eq.verified'](eq.n_tests)}</a>
  </figcaption>
  <details class="pe-eq__details">
    <summary>{t['eq.details']}</summary>
    <dl>
      <dt>{t['eq.assumptions']}</dt>
      <dd>
        <ul>
          {eq.assumptions.map((a) => <li>{catalog.assumption_labels[a]?.[locale] ?? a}</li>)}
        </ul>
      </dd>
      {
        convention && (
          <>
            <dt>{t['eq.convention']}</dt>
            <dd set:html={renderInlineMath(convention)} />
          </>
        )
      }
      {
        notes && (
          <>
            <dt>{t['eq.notes']}</dt>
            <dd set:html={renderInlineMath(notes)} />
          </>
        )
      }
      <dt>{t['eq.source']}</dt>
      <dd>
        {
          cites.map((c, i) => (
            <>
              {i > 0 && '; '}
              <a href={pageHref(locale, BIBLIOGRAPHY_SLUG, c.key)}>{c.entry.label}</a>
              {c.where && <span>, {c.where}</span>}
            </>
          ))
        }
      </dd>
      {
        derivModule && (
          <>
            <dt>{t['eq.derivation']}</dt>
            <dd>
              <a href={pageHref(locale, DERIVATIONS_SLUG, `deriv-${derivModule}`)}>{t['eq.derivationLink']}</a>
            </dd>
          </>
        )
      }
      <dt>{t['eq.id']}</dt>
      <dd>
        <code>{id}</code> · <a href={yamlHref}>{t['eq.yaml']}</a>
      </dd>
    </dl>
  </details>
</figure>
