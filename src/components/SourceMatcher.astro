---
/**
 * <SourceMatcher /> -- the source-matcher island with labels in the page's
 * language and presets from the source examples (examples/synthetic). State lives in
 * the URL hash.
 */
import SourceIsland from '../tools/SourceMatcher.tsx';
import { toolSymbols } from '../i18n/symbols';
import { ui } from '../i18n/ui';
import { pageLocale } from '../lib/locale';
import { pageHref } from '../lib/paths';
import { SOURCE_PRESETS, sourceValues } from '../lib/sourcepresets';

const locale = pageLocale(Astro);
const t = ui[locale];
const labels = {
  presets: t['sm.presets'],
  source: t['sm.source'],
  converter: t['sm.converter'],
  envelope: t['sm.envelope'],
  envelopeKinds: { none: t['sm.envNone'], sine: t['sm.envSine'], points: t['sm.envPoints'] },
  pointsHelp: t['sm.pointsHelp'],
  results: t['sm.results'],
  quantity: t['sim.quantity'],
  value: t['des.value'],
  equation: t['sim.formula'],
  rin: t['sm.rin'],
  etaLfr: t['sm.etaLfr'],
  vgcrit: t['sm.vgcrit'],
  voccrit: t['sm.voccrit'],
  mode: t['sm.mode'],
  modes: { LFR: t['sm.modeLFR'], CV: t['sm.modeCV'] },
  vg: t['sm.vg'],
  power: t['sm.power'],
  pmax: t['sm.pmax'],
  eta: t['sm.eta'],
  vds: t['sm.vds'],
  vdsCcm: t['sm.vdsCcm'],
  plfr: t['sm.plfr'],
  limitCcm: t['sm.limitCcm'],
  limitSwitch: t['sm.limitSwitch'],
  overRating: t['sm.overRating'],
  ripple: t['sm.ripple'],
  extractionChart: t['sm.extractionChart'],
  amplitude: t['sm.amplitude'],
  share: t['sm.share'],
  plotHint: t['tool.plotHint'],
  siHint: t['tool.siHint'],
  lfrCurve: t['sm.lfrCurve'],
  cvCurve: t['sm.cvCurve'],
  actual: t['sm.actual'],
  switchChart: t['sm.switchChart'],
  powerAxis: t['sm.powerAxis'],
  vdsAxis: t['sm.vdsAxis'],
  rating: t['sm.rating'],
  envelopeChart: t['sm.envelopeChart'],
  time: t['sm.time'],
  voltage: t['sm.voltage'],
  vbus: t['sm.vbus'],
  voc: t['sm.voc'],
  pIn: t['sm.pIn'],
  pAvail: t['sm.pAvail'],
  etaEnvelope: t['sm.etaEnvelope'],
  running: t['sm.running'],
  tooLong: t['sm.tooLong'],
  tooFast: t['sm.tooFast'],
  runFailed: t['sm.runFailed'],
  simulate: t['sm.simulate'],
  invalid: t['sm.invalid'],
  shareUrl: t['sm.shareUrl'],
};
const PRESET_LABEL: Record<string, string> = {
  'source-lfr': t['sm.presetConstant'],
  'source-envelope': t['sm.presetSine'],
};
const presets = SOURCE_PRESETS.map((id) => ({ id, label: PRESET_LABEL[id] ?? id, values: sourceValues(id) }));
const simulatorHref = pageHref(locale, 'simulate/simulator');
---

<div class="pe-wide">
  <SourceIsland client:only="react" locale={locale} labels={labels} presets={presets} simulatorHref={simulatorHref} symbols={toolSymbols(locale)} />
</div>
