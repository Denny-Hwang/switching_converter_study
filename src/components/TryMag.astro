---
/**
 * <TryMag example="mag-kg" /> -- deep link into the magnetics designer with
 * the design of a preset (its device, core and fields in the URL hash).
 */
import { ui } from '../i18n/ui';
import { pageHref } from '../lib/paths';
import { pageLocale } from '../lib/locale';
import { getExample } from '../lib/examples';
import { magHash } from '../lib/magpresets';

interface Props {
  example: string;
}
const { example } = Astro.props;
const locale = pageLocale(Astro);
const t = ui[locale];
const href = `${pageHref(locale, 'design/magnetics-designer')}#${magHash(example)}`;
const ex = getExample(example);
const label = locale === 'ko' ? ex.label_ko : ex.label;
---

<p class="pe-tryit">
  <a class="pe-tryit__link" href={href}>▶ {t['trymag.open']}: {label}</a>
  <br /><small>{t['trymag.preset']} <code>{example}</code></small>
</p>
