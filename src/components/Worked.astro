---
/**
 * <Worked example="buck-basic" show={['T_s', 'K', 'K_crit']} /> -- a worked
 * example computed by pe-core at build time from a synthetic parameter set
 * (examples/synthetic/<example>.yaml). The table carries the example's label;
 * the page footer says that example numbers are synthetic (PRIVACY_RULES.md).
 * Each symbol shows what it means (the catalogue's `meaning`).
 */
import katex from 'katex';
import { catalog } from 'pe-core';
import { REPO_BLOB } from '../config';
import { ui } from '../i18n/ui';
import { katexOptions } from '../math/katex-options';
import { getExample, symbolOf } from '../lib/examples';
import { formatSI } from '../lib/format';
import { eqAnchor, eqHomes } from '../lib/eqhomes';
import { pageHref } from '../lib/paths';
import { pageLocale } from '../lib/locale';
import { symHtml } from '../lib/sym';

interface Props {
  example: string;
  /** Context names to show, in order (default: every param and result). */
  show?: string[];
  /** Show the example's checks (e.g. CCM/DCM). Default true. */
  checks?: boolean;
}
const { example, show, checks = true } = Astro.props;
const ex = getExample(example);
const locale = pageLocale(Astro);
const t = ui[locale];
const homes = await eqHomes(locale);

/** What a symbol is, in the page's language, with subscripts. */
const meaningOf = (s: { meaning: string; meaning_ko: string }) => symHtml(locale === 'ko' ? s.meaning_ko : s.meaning);

const names = show ?? [...Object.keys(ex.params), ...ex.results.map((r) => r.name)];
const rows = names.map((name) => {
  if (name in ex.params) {
    // a catalogue symbol, or one with a suffix (f_lo: the frequency f, tagged "lo")
    const of = symbolOf(name);
    if (!of) throw new Error(`<Worked example="${example}">: param ${name} is not a known symbol`);
    const sym = catalog.symbols[of.symbol]!;
    const latex = of.suffix ? `{${sym.latex}}_{\\mathrm{${of.suffix}}}` : sym.latex;
    return { name, latex, meaning: meaningOf(sym), value: formatSI(ex.params[name]!, sym.unit), given: true as const };
  }
  const r = ex.results.find((x) => x.name === name);
  if (!r) throw new Error(`<Worked example="${example}">: "${name}" is neither a param nor a step result`);
  const meta = catalog.equations[r.eq]!;
  // A result stored under another name (`as:` in the example) shows that
  // name: its own symbol if it is one (G_vd), else the lhs tagged with the
  // suffix (M_dcm -> M_dcm with an upright "dcm").
  const own = catalog.symbols[name];
  const lhs = catalog.symbols[r.symbol]!;
  const suffix = name.startsWith(`${r.symbol}_`) ? name.slice(r.symbol.length + 1) : '';
  const latex = own ? own.latex : suffix ? `{${lhs.latex}}_{\\mathrm{${suffix}}}` : lhs.latex;
  const home = homes.get(r.eq);
  const href = home ? pageHref(locale, home, eqAnchor(r.eq)) : `${REPO_BLOB}/packages/pe-core/equations/equations.yaml#L${meta.yaml_line}`;
  return {
    name,
    latex,
    meaning: meaningOf(own ?? lhs),
    value: formatSI(r.value, lhs.unit),
    given: false as const,
    title: locale === 'ko' ? meta.title_ko : meta.title,
    href,
  };
});
const label = locale === 'ko' ? ex.label_ko : ex.label;

/** "K > K_crit" -> KaTeX, with symbol names replaced by their LaTeX. */
const OPS: Record<string, string> = { '>': '>', '<': '<', '>=': '\\ge', '<=': '\\le' };
function conditionHtml(when: string): string {
  const tex = when
    .trim()
    .split(/\s+/)
    .map((tok) => OPS[tok] ?? catalog.symbols[tok]?.latex ?? tok)
    .join(' ');
  return katex.renderToString(tex, katexOptions(false));
}
---

<figure class="pe-worked not-content">
  <figcaption class="pe-worked__label" set:html={symHtml(label)} />
  <table>
    <thead>
      <tr><th>{t['worked.symbol']}</th><th>{t['worked.value']}</th><th>{t['worked.source']}</th></tr>
    </thead>
    <tbody>
      {
        rows.map((r) => (
          <tr class={r.given ? 'is-given' : 'is-computed'}>
            <td>
              <span set:html={katex.renderToString(r.latex, katexOptions(false))} />{' '}
              <span class="pe-worked__meaning" set:html={r.meaning} />
            </td>
            <td class="pe-worked__value">{r.value}</td>
            <td>{r.given ? t['worked.given'] : <a href={r.href}>{r.title}</a>}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
  {
    checks && ex.checkResults.length > 0 && (
      <p class="pe-worked__checks">
        {t['worked.checks']}:{' '}
        {ex.checkResults.map((c) => (
          <span>
            <strong>{c.text[locale]}</strong> (<span set:html={conditionHtml(c.when)} />:{' '}
            {c.ok ? t['worked.holds'] : t['worked.fails']}){' '}
          </span>
        ))}
      </p>
    )
  }
</figure>
